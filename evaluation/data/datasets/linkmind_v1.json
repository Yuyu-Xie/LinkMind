    {
      "key": "django-async-queue",
      "question": "为什么 Django 项目要把长任务放到异步队列，任务如何设计才安全？",
      "reference_answer": "长任务会占满请求 worker；任务队列把执行移出请求周期。任务只传主键、状态落库，配合条件更新和租约避免重复执行，并按错误类型决定是否重试。",
      "reference_sources": ["https://eval.local/django/huey"],
      "reference_evidence": [
        {
          "url": "https://eval.local/django/huey",
          "quote": "放在请求周期内会占满 worker，导致超时和重试",
          "key_facts": [{"any": ["占满 worker", "占用 worker"]}, {"any": ["超时", "timeout"]}]
        },
        {
          "url": "https://eval.local/django/huey",
          "quote": "任务参数应尽量小，通常只传主键，业务状态写入数据库",
          "key_facts": [{"any": ["只传主键", "传递主键", "传主键"]}, {"any": ["业务状态", "状态写入数据库"]}]
        },
        {
          "url": "https://eval.local/django/huey",
          "quote": "网络超时、限流、服务端 5xx 可以退避重试；参数错误和鉴权失败应立即失败并暴露错误",
          "key_facts": [{"any": ["退避重试", "指数退避"]}, {"any": ["鉴权失败", "认证失败", "参数错误"]}]
        }

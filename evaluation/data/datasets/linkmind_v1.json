    {
      "key": "redis-persistence-choice",
      "question": "Redis 的 RDB 和 AOF 持久化如何取舍？",
      "reference_answer": "RDB 快照紧凑、恢复快但可能丢数据；AOF 每秒刷盘丢失窗口小但文件大；生产上常同时开启。纯缓存场景可以关闭持久化。",
      "reference_sources": ["https://eval.local/redis/persistence"],
      "reference_evidence": [
        {
          "url": "https://eval.local/redis/persistence",
          "quote": "RDB 在指定时间间隔生成数据快照，文件紧凑，恢复速度快，但两次快照之间的数据可能丢失",
          "key_facts": ["RDB", {"any": ["快照", "snapshot"]}, {"any": ["恢复速度快", "恢复快"]}]
        },
        {
          "url": "https://eval.local/redis/persistence",
          "quote": "AOF 追加写命令日志，可以配置 everysec 每秒刷盘，最多丢失约一秒数据",
          "key_facts": ["AOF", {"any": ["每秒刷盘", "everysec"]}, {"any": ["一秒", "1 秒", "1秒"]}]
        },
        {
          "url": "https://eval.local/redis/persistence",
          "quote": "生产环境常见组合是同时开启 RDB 和 AOF",
          "key_facts": [{"any": ["同时开启", "同时使用", "组合"]}]
        }
      ]

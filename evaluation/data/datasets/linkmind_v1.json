      "key": "pg-index-choice",
      "question": "PostgreSQL 的 B-tree、GIN、BRIN 索引分别适合什么场景？",
      "reference_answer": "B-tree 支持等值、范围和排序，是默认索引；GIN 适合数组、JSONB 和全文检索；BRIN 体积小，适合按物理顺序写入的时间序列数据。",
      "reference_sources": ["https://eval.local/postgresql/index-types"],
      "reference_evidence": [
        {
          "url": "https://eval.local/postgresql/index-types",
          "quote": "B-tree 支持等值查询、范围查询和排序，适用于大多数 OLTP 场景",
          "key_facts": ["B-tree", {"any": ["范围查询", "范围扫描"]}, {"any": ["默认索引", "默认的索引"]}]
        },
        {
          "url": "https://eval.local/postgresql/index-types",
          "quote": "GIN 是倒排索引，适合数组、JSONB、tsvector 全文检索",
          "key_facts": ["GIN", "JSONB", "全文检索"]
        },
        {
          "url": "https://eval.local/postgresql/index-types",
          "quote": "BRIN 保存每个数据块的摘要，体积很小，适合按物理顺序写入的时间序列数据",
          "key_facts": ["BRIN", {"any": ["数据块", "block"]}, {"any": ["时间序列", "时序"]}]
        }
      ]
    },
